{
  "name": "通用硕博",
  "description": "硕士、博士学位论文的通用格式要求，页边距更宽、标题层级字号更大。",
  "source": "GB/T 7713.1—2006《学位论文编写规则》+ 高校通用硕博学位论文格式要求（2023 版）",
  "page": {
    "size": "A4",
    "margin_top_mm": 30.0,
    "margin_bottom_mm": 25.0,
    "margin_left_mm": 30.0,
    "margin_right_mm": 25.0,
    "tolerance_mm": 1.0
  },
  "body": {
    "font_east_asia": "宋体",
    "size_pt": 12.0,
    "first_line_indent_chars": 2,
    "space_before_pt_max": 0,
    "space_after_pt_max": 0
  },
  "line_spacing": {
    "rule": "exact",
    "value": 20
  },
  "headings": {
    "1": {"font_east_asia": "黑体", "size_pt": 16.0, "bold": true},
    "2": {"font_east_asia": "黑体", "size_pt": 14.0, "bold": true},
    "3": {"font_east_asia": "黑体", "size_pt": 12.0, "bold": false}
  },
  "references": {
    "heading_text": "参考文献",
    "style": "GB/T 7714-2015 顺序编码制"
  }
}
